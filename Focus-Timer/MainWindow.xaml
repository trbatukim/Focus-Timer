<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Focus_Timer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Focus_Timer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Focus-Timer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32" VerticalAlignment="Top">
            <TextBlock Text="Focus Timer" VerticalAlignment="Center" Margin="12,0,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock x:Name="ModeText" Text="Focus"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="FocusInputLabel" Text="Enter Focus Time"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <NumberBox
                            x:Name="FocusInputMinutes"
                            Header="Minutes"
                            ValueChanged="FocusInput_ValueChanged"
                            PlaceholderText="MM"
                            Minimum="0"
                            Maximum="180"
                            Width="110" />
                        <NumberBox
                            x:Name="FocusInputSeconds"
                            Header="Seconds"
                            ValueChanged="FocusInput_ValueChanged"
                            PlaceholderText="SS"
                            Minimum="0"
                            Maximum="59"
                        Width="110" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="BreakInputLabel" Text="Enter Break Time"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <NumberBox
                            x:Name="BreakInputMinutes"
                            Header="Minutes"
                            ValueChanged="BreakInput_ValueChanged"
                            PlaceholderText="MM"
                            Minimum="0"
                            Maximum="180"
                            Width="110" />
                        <NumberBox
                            x:Name="BreakInputSeconds"
                            Header="Seconds"
                            ValueChanged="BreakInput_ValueChanged"
                            PlaceholderText="SS"
                            Minimum="0"
                            Maximum="59"
                            Width="110" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TimeText" Text="25:00"
                   FontSize="72" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />

            <ProgressBar x:Name="Progress" Width="300" Maximum="1" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="StartButton" Content="Start"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="StartButton_Click" />
                <Button Content="Reset" Click="ResetButton_Click" />
                <Button Content="Skip" Click="SkipButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock x:Name="GlobalFocusLabel" Text="You've focused for a total of: "
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center" />
                <TextBlock x:Name="GlobalFocusTimeLabel" Text=""
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="DNDStatusText" Text="Tip: Turn Do Not Disturb on to focus"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
