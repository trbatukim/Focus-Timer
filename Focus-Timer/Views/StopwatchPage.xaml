<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Focus_Timer.Views.StopwatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Focus_Timer.Services"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,8,24,24">
            <StackPanel MaxWidth="560" Spacing="12"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">

                <!-- Stopwatch card -->
                <Border Style="{StaticResource CardStyle}" Padding="24,28">
                    <StackPanel Spacing="18" HorizontalAlignment="Stretch">
                        <Border HorizontalAlignment="Center" Padding="14,4" CornerRadius="12"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="Stopwatch"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       CharacterSpacing="60" />
                        </Border>

                        <TextBlock FontFamily="Segoe UI Variable Display"
                                   FontSize="72" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center">
                            <Run x:Name="TimeRun" Text="00:00:00" /><Run x:Name="FractionRun" Text=".00" FontSize="40"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button x:Name="StartButton" Content="Start" MinWidth="120"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="StartButton_Click" />
                            <Button x:Name="LapButton" Click="LapButton_Click"
                                    IsEnabled="False" ToolTipService.ToolTip="Record a lap">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C1;" FontSize="14" />
                                    <TextBlock Text="Lap" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResetButton" Click="ResetButton_Click"
                                    IsEnabled="False" ToolTipService.ToolTip="Reset">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Reset" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Laps -->
                <Border x:Name="LapsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C1;" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Laps" Style="{StaticResource CardHeaderStyle}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LapsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:LapEntry">
                                        <Grid Padding="0,6" ColumnSpacing="12" Margin="0,0,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind LapTimeText}"
                                                       FontFamily="Segoe UI Variable Display"
                                                       Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind TotalText}" MinWidth="96"
                                                       TextAlignment="Right"
                                                       FontFamily="Segoe UI Variable Display"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
